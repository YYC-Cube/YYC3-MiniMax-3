{
  "name": "yyc3-minimax-3",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "description": "YYC³ AI Family · Comic Drama — AI 驱动的工业化漫剧生产平台：8 Agent 协同，小说到成片全链路闭环（React 19 + Vite 8 + Tailwind v4 + PWA）",
  "keywords": [
    "yyc3",
    "yanyucloudcube",
    "ai-family",
    "comic-drama",
    "short-drama",
    "multi-agent",
    "react-19",
    "typescript",
    "vite",
    "tailwindcss",
    "pwa",
    "figma-make",
    "ai-production",
    "github-pages",
    "quality-gates"
  ],
  "homepage": "https://minimax-h3.yyc3.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YYC-Cube/YYC3-MiniMax-3.git"
  },
  "bugs": {
    "url": "https://github.com/YYC-Cube/YYC3-MiniMax-3/issues"
  },
  "author": "YanYuCloudCube Team <admin@0379.email>",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:arch": "node scripts/check-boundaries.mjs",
    "smoke:dist": "node scripts/dist-smoke.mjs",
    "audit:mobile": "node scripts/mobile-audit.mjs && VW=768 VH=1024 node scripts/mobile-audit.mjs",
    "check:pwa": "node scripts/pwa-install-check.mjs",
    "verify": "pnpm typecheck && pnpm test:coverage && pnpm build && pnpm smoke:dist && pnpm check:arch"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.2.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.3"
  }
}
